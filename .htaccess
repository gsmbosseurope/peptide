RewriteEngine On

# The admin panel's frontend (admin.js) calls /api/... at the site root
# (matching how it worked as a standalone Node server). Route those
# requests to the PHP API router living in /admin/.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ admin/api.php?path=/api/$1 [QSA,L]

# ---------- Clean URLs: hide the .html extension ----------
# 1) If someone visits /about.html directly, send them to /about instead
#    (a permanent redirect, so search engines and bookmarks settle on the
#    clean URL rather than indexing both versions).
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Internally, when /about is requested, quietly serve about.html
#    (no visible redirect — the address bar keeps showing /about).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
